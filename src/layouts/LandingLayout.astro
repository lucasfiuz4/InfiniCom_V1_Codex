---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { site } from '../config/site';
import ConsentBanner from '../components/ConsentBanner.astro';
import TrackingHead from '../components/TrackingHead.astro';
import TrackingNoScript from '../components/TrackingNoScript.astro';
import logoActive from '../assets/brand/infinicom-logo-active.svg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = true,
  schema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <TrackingHead />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#29003d" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
    <title>{title}</title>
  </head>
  <body>
    <TrackingNoScript />
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-ink">
      Ir para o conteúdo
    </a>

    <header class="border-b border-[var(--color-border)] bg-white" aria-label="Cabeçalho da campanha">
      <div class="container-shell flex h-[72px] items-center justify-between gap-5">
        <Image
          src={logoActive}
          alt="INFINICOM"
          width={76}
          loading="eager"
          class="h-[54px] w-auto object-contain"
        />
        <p class="hidden text-sm font-medium text-muted sm:block">Atendimento comercial INFINICOM</p>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)] bg-white">
      <div class="container-shell flex flex-col gap-4 py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} INFINICOM. Todos os direitos reservados.</p>
        <nav class="flex flex-wrap gap-5" aria-label="Links legais">
          <a class="font-medium hover:text-brand" href="/privacidade">Privacidade</a>
          <a class="font-medium hover:text-brand" href="/cookies">Cookies</a>
          <button type="button" class="font-medium hover:text-brand" x-on:click="window.infinicomConsent?.open()">Gerenciar cookies</button>
        </nav>
      </div>
    </footer>
    <ConsentBanner />
  </body>
</html>
