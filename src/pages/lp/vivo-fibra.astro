---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import LandingLayout from '../../layouts/LandingLayout.astro';
import WhatsAppForm from '../../components/WhatsAppForm.astro';
import homeImage from '../../assets/images/conectividade-casa.png';
import consultingImage from '../../assets/images/hero-consultoria.png';

const benefits = [
  {
    icon: 'lucide:map-pin-check',
    title: 'Consulta pelo endereço',
    text: 'A disponibilidade é verificada de acordo com a localização informada.',
    tone: 'bg-brand-deep text-white md:col-span-7',
  },
  {
    icon: 'lucide:messages-square',
    title: 'Orientação comercial',
    text: 'A equipe ajuda a organizar sua necessidade antes de apresentar o próximo passo.',
    tone: 'border border-[var(--color-border)] bg-white md:col-span-5',
  },
  {
    icon: 'lucide:house-wifi',
    title: 'Para diferentes rotinas',
    text: 'Informe se a consulta é para casa, empresa ou empreendimento.',
    tone: 'border border-[var(--color-border)] bg-soft md:col-span-5',
  },
  {
    icon: 'lucide:message-circle-check',
    title: 'Continuidade pelo WhatsApp',
    text: 'Os dados preenchidos viram uma mensagem pronta para confirmar e enviar.',
    tone: 'bg-[#461e5f] text-white md:col-span-7',
  },
];

const questions = [
  ['Como saber se há cobertura no meu endereço?', 'Preencha sua cidade e os detalhes do endereço. A equipe confirma a disponibilidade antes de orientar a contratação.'],
  ['Os valores são os mesmos em todas as regiões?', 'Condições e disponibilidade podem variar. O atendimento considera somente as informações aplicáveis ao endereço consultado.'],
  ['A contratação é feita pela INFINICOM?', 'A INFINICOM realiza o atendimento comercial e acompanha o processo relacionado às soluções apresentadas.'],
  ['Posso consultar uma solução para empresa?', 'Sim. Selecione o perfil Empresa no formulário e descreva o contexto de uso.'],
];
---

<LandingLayout
  title="Consulte Vivo Fibra com a INFINICOM"
  description="Consulte a cobertura de Vivo Fibra e receba atendimento comercial da INFINICOM pelo WhatsApp."
  noindex
>
  <section class="bg-[linear-gradient(118deg,#660099_0%,#461e5f_100%)] text-white">
    <div class="container-shell grid min-h-[calc(100dvh-72px)] items-center gap-10 py-12 lg:grid-cols-[0.95fr_1.05fr] lg:py-16">
      <div>
        <p class="eyebrow text-fuchsia-100">Vivo Fibra com a INFINICOM</p>
        <h1 class="display-title hero-title-balanced mt-5 max-w-[12ch]">Consulte Vivo Fibra.</h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-7 text-fuchsia-50/85">Consulte a disponibilidade e receba orientação comercial da INFINICOM pelo WhatsApp.</p>
        <a class="btn btn-light mt-8" href="#consulta">Consultar cobertura <Icon name="lucide:arrow-down-right" class="size-4" /></a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-white/15 bg-white/10 p-2">
        <Image
          src={homeImage}
          alt="Família conectada usando internet em casa"
          widths={[480, 768, 1100]}
          sizes="(max-width: 1023px) 100vw, 52vw"
          format="webp"
          quality={82}
          loading="eager"
          class="aspect-[4/3] w-full rounded-xl object-cover"
        />
      </div>
    </div>
  </section>

  <section class="section-space bg-white" aria-labelledby="benefits-title">
    <div class="container-shell">
      <h2 id="benefits-title" class="section-title max-w-[16ch]">Uma consulta simples, com contexto</h2>
      <p class="mt-5 max-w-[58ch] text-lg leading-7 text-muted">Antes de falar sobre contratação, a equipe entende onde e como a conexão será utilizada.</p>

      <div class="mt-12 grid gap-5 md:grid-cols-12">
        {benefits.map((benefit) => (
          <article class:list={['rounded-2xl p-7 sm:p-8', benefit.tone]}>
            <Icon name={benefit.icon} class:list={['size-7', benefit.tone.includes('text-white') ? 'text-fuchsia-200' : 'text-brand']} />
            <h3 class="mt-12 text-2xl font-semibold">{benefit.title}</h3>
            <p class:list={['mt-4 max-w-[42ch] leading-7', benefit.tone.includes('text-white') ? 'text-fuchsia-100/80' : 'text-muted']}>{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-soft" aria-labelledby="authority-title">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-20">
      <div class="overflow-hidden rounded-2xl bg-white p-2 shadow-[var(--shadow-soft)]">
        <Image
          src={consultingImage}
          alt="Atendimento consultivo da INFINICOM"
          widths={[480, 768, 960]}
          sizes="(max-width: 1023px) 100vw, 45vw"
          format="webp"
          quality={78}
          loading="lazy"
          class="aspect-[4/3] w-full rounded-xl object-cover"
        />
      </div>
      <div>
        <h2 id="authority-title" class="section-title max-w-[15ch]">Atendimento da INFINICOM</h2>
        <p class="mt-5 max-w-[56ch] text-lg leading-8 text-muted">A INFINICOM é responsável pelo atendimento comercial desta página e apresenta soluções do portfólio Vivo conforme a disponibilidade consultada.</p>
        <div class="mt-8 grid gap-5 border-l-2 border-brand/25 pl-6">
          <p class="font-display text-lg font-semibold text-ink">A marca responsável pelo site é a INFINICOM.</p>
          <p class="leading-7 text-muted">A Vivo aparece como marca parceira e titular das soluções apresentadas.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space bg-white" aria-labelledby="process-title">
    <div class="container-shell">
      <h2 id="process-title" class="section-title">Como funciona</h2>
      <p class="mt-5 max-w-[58ch] text-lg leading-7 text-muted">Você compartilha o contexto essencial e continua a conversa no canal de atendimento.</p>

      <div class="mt-12 grid gap-8 md:grid-cols-3 md:gap-0">
        {[
          ['lucide:map-pinned', 'Informe o endereço', 'Compartilhe a cidade e os dados necessários para a consulta.'],
          ['lucide:clipboard-pen-line', 'Descreva sua necessidade', 'Selecione o perfil e conte como pretende utilizar a conexão.'],
          ['lucide:message-circle', 'Continue pelo WhatsApp', 'Confirme a mensagem preparada e envie para a equipe INFINICOM.'],
        ].map(([icon, title, text], index) => (
          <article class:list={['md:px-8', index === 0 ? 'md:pl-0' : 'md:border-l md:border-[var(--color-border)]', index === 2 && 'md:pr-0']}>
            <Icon name={icon} class="size-6 text-brand" />
            <h3 class="mt-8 text-xl font-semibold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-soft" aria-labelledby="faq-title">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <h2 id="faq-title" class="section-title">Perguntas sobre a consulta</h2>
      <div class="grid gap-3" x-data="{ active: 0 }">
        {questions.map(([question, answer], index) => (
          <article class="rounded-2xl border border-[var(--color-border)] bg-white">
            <h3>
              <button type="button" class="flex min-h-16 w-full items-center justify-between gap-5 px-5 py-4 text-left font-display text-lg font-semibold" x-on:click={`active = active === ${index} ? -1 : ${index}`} x-bind:aria-expanded={`active === ${index}`}>
                <span>{question}</span>
                <Icon name="lucide:plus" class="size-5 shrink-0 text-brand transition-transform" x-bind:class={`active === ${index} && 'rotate-45'`} />
              </button>
            </h3>
            <div class="px-5 pb-5 pr-12 leading-7 text-muted" x-show={`active === ${index}`}>
              <p>{answer}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space scroll-mt-10 bg-white" id="consulta" aria-labelledby="form-title">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-20">
      <div>
        <p class="eyebrow text-brand">Consulta de cobertura</p>
        <h2 id="form-title" class="section-title mt-4">Comece pelo seu endereço</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-7 text-muted">Preencha os dados essenciais. A mensagem será preparada para continuar no WhatsApp.</p>
      </div>
      <WhatsAppForm title="Consultar cobertura" compact campaign="lp-vivo-fibra" product="Vivo Fibra" />
    </div>
  </section>

  <section class="bg-[#461e5f] py-16 text-white sm:py-20">
    <div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="section-title">Consulte o que está disponível</h2>
        <p class="mt-4 max-w-xl text-lg leading-7 text-fuchsia-100/75">Envie seu endereço e continue o atendimento pelo WhatsApp.</p>
      </div>
      <a class="btn btn-light" href="#consulta">Consultar cobertura <Icon name="lucide:arrow-up-right" class="size-4" /></a>
    </div>
  </section>
</LandingLayout>
