---
import { Icon } from 'astro-icon/components';
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Obrigado pelo contato | INFINICOM"
  description="Continue seu atendimento com a equipe da INFINICOM pelo WhatsApp."
  noindex
>
  <section class="bg-canvas py-10 sm:py-14 lg:py-16">
    <div class="container-shell">
      <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Obrigado' }]} />

      <div class="grid overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-[var(--shadow-soft)] lg:grid-cols-[1.08fr_0.92fr]">
        <div class="relative isolate overflow-hidden bg-brand-deep p-8 text-white sm:p-12 lg:p-14">
          <div class="pointer-events-none absolute -bottom-32 -left-24 size-80 rounded-full bg-fuchsia-400/10 blur-3xl"></div>
          <div class="relative">
            <div class="flex size-14 items-center justify-center rounded-xl border border-white/15 bg-white/10">
              <Icon name="lucide:circle-check-big" class="size-7 text-fuchsia-100" />
            </div>
            <h1 class="mt-8 max-w-[11ch] text-4xl font-semibold leading-[1.06] sm:text-5xl">Obrigado pelo contato</h1>
            <p class="mt-5 max-w-[34rem] text-lg leading-7 text-fuchsia-50/80">
              O atendimento continua pelo WhatsApp. Se a conversa não abriu, use o botão para falar com a equipe.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a class="btn btn-light" href={site.floatingWhatsappUrl} target="_blank" rel="noreferrer">
                <Icon name="lucide:message-circle" class="size-5" />
                Continuar no WhatsApp
              </a>
              <a class="btn border border-white/30 text-white hover:bg-white/10" href="/">
                Voltar ao início
              </a>
            </div>
          </div>
        </div>

        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-14" aria-labelledby="next-title">
          <h2 id="next-title" class="text-2xl font-semibold text-ink sm:text-3xl">O que fazer agora</h2>
          <p class="mt-3 max-w-[34rem] leading-7 text-muted">Revise a mensagem e envie quando estiver pronto para iniciar a conversa.</p>

          <div class="mt-9 space-y-8">
            <div class="grid grid-cols-[auto_1fr] gap-4">
              <div class="flex size-11 items-center justify-center rounded-xl bg-soft text-brand">
                <Icon name="lucide:message-square-text" class="size-5" />
              </div>
              <div>
                <h3 class="font-semibold text-ink">Confirme a mensagem</h3>
                <p class="mt-1 leading-6 text-muted">Você pode ajustar o texto antes de enviá-lo no WhatsApp.</p>
              </div>
            </div>

            <div class="grid grid-cols-[auto_1fr] gap-4">
              <div class="flex size-11 items-center justify-center rounded-xl bg-soft text-brand">
                <Icon name="lucide:messages-square" class="size-5" />
              </div>
              <div>
                <h3 class="font-semibold text-ink">Converse com a equipe</h3>
                <p class="mt-1 leading-6 text-muted">Compartilhe sua necessidade para receber orientação sobre o próximo passo.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
