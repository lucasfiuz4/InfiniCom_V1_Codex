---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactIntentForm from '../../components/ContactIntentForm.astro';
import contactImage from '../../assets/images/hero-consultoria.png';
---

<BaseLayout
  title="Contato | Fale com a INFINICOM"
  description="Escolha o motivo do contato e envie sua solicitação para a equipe INFINICOM pelo WhatsApp."
>
  <section class="bg-canvas">
    <div class="container-shell py-10 sm:py-14 lg:py-16">
      <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Contato' }]} />

      <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow text-brand">Contato INFINICOM</p>
          <h1 class="display-title hero-title-balanced mt-5 max-w-[12ch]">Como podemos ajudar?</h1>
          <p class="mt-6 max-w-[34rem] text-lg leading-7 text-muted">Escolha o motivo do contato para preparar uma mensagem adequada ao seu atendimento.</p>
          <a class="btn btn-primary mt-8" href="#atendimento">
            Escolher atendimento
            <Icon name="lucide:arrow-down-right" class="size-4" />
          </a>
        </div>

        <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white p-2 shadow-[var(--shadow-soft)]">
          <Image
            src={contactImage}
            alt="Profissional da INFINICOM durante um atendimento"
            widths={[480, 768, 1100]}
            sizes="(max-width: 1023px) 100vw, 52vw"
            format="webp"
            quality={82}
            loading="eager"
            class="aspect-[16/11] w-full rounded-xl object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section-space scroll-mt-24 bg-white" id="atendimento" aria-labelledby="atendimento-title">
    <div class="container-shell">
      <h2 id="atendimento-title" class="section-title">Escolha o motivo do contato</h2>
      <p class="mt-5 max-w-[58ch] text-lg leading-7 text-muted">O formulário se adapta para reunir apenas as informações relevantes em cada situação.</p>
      <div class="mt-10">
        <ContactIntentForm />
      </div>
    </div>
  </section>

  <section class="section-space bg-soft" aria-labelledby="next-title">
    <div class="container-shell">
      <h2 id="next-title" class="section-title">Como funciona o atendimento</h2>
      <p class="mt-5 max-w-[58ch] text-lg leading-7 text-muted">Você escolhe o assunto, compartilha o contexto e continua a conversa pelo WhatsApp.</p>

      <div class="mt-12 grid gap-8 md:grid-cols-3 md:gap-0">
        {[
          ['lucide:mouse-pointer-click', 'Escolha o motivo', 'Selecione contratação, cliente atual ou dúvida.'],
          ['lucide:clipboard-pen-line', 'Preencha as informações', 'Conte o contexto necessário para a equipe entender sua solicitação.'],
          ['lucide:message-circle', 'Continue pelo WhatsApp', 'A mensagem será preparada para você confirmar e enviar à equipe.'],
        ].map(([icon, title, text], index) => (
          <article class:list={['md:px-8', index === 0 ? 'md:pl-0' : 'md:border-l md:border-[var(--color-border)]', index === 2 && 'md:pr-0']}>
            <Icon name={icon} class="size-6 text-brand" />
            <h3 class="mt-8 text-xl font-semibold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
