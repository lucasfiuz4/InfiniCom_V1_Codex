<script is:inline>
  (() => {
    const inferProduct = () => {
      const path = window.location.pathname;
      if (path.includes('vivo-fibra')) return 'Vivo Fibra';
      if (path.includes('internet-empresarial')) return 'Internet empresarial';
      return 'Não informado';
    };

    const inferLocation = (element) => {
      const explicitContext = element.closest('[data-whatsapp-location]');
      if (explicitContext?.dataset.whatsappLocation) return explicitContext.dataset.whatsappLocation;
      if (element.closest('header')) return 'header';
      if (element.closest('footer')) return 'footer';
      const section = element.closest('section[id]');
      return section?.id ? `section_${section.id}` : 'conteudo';
    };

    window.infinicomTracking = window.infinicomTracking || {};
    window.infinicomTracking.trackWhatsApp = (details = {}) => {
      const payload = {
        cta_location: details.ctaLocation || 'Não informado',
        cta_type: details.ctaType || 'link',
        product: details.product || inferProduct(),
        page_path: window.location.pathname,
      };

      if (window.infinicomTrackingAllowed === true && typeof window.gtag === 'function') {
        window.gtag('event', 'whatsapp_click', payload);
      }
    };

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a[href]');
      if (!link) return;

      const href = link.getAttribute('href') || '';
      const isWhatsApp = href.includes('wa.me/') || href.includes('api.whatsapp.com/');
      if (!isWhatsApp) return;

      const productContext = link.closest('[data-whatsapp-product]');
      window.infinicomTracking.trackWhatsApp({
        ctaLocation: inferLocation(link),
        ctaType: link.dataset.whatsappType || 'link',
        product: link.dataset.whatsappProduct || productContext?.dataset.whatsappProduct || inferProduct(),
      });
    });
  })();
</script>
