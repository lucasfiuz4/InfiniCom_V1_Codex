---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../config/site';
import logoActive from '../assets/brand/infinicom-logo-active.svg';

const consultorUrl = whatsappUrl('Olá, quero falar com um consultor da INFINICOM.');
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-white/95 text-ink backdrop-blur-md" x-data="{ open: false }">
  <div class="container-shell flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="flex h-14 items-center" aria-label="InfiniCom, página inicial">
      <Image
        src={logoActive}
        alt="InfiniCom"
        width={76}
        loading="eager"
        class="h-[54px] w-auto object-contain"
      />
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium xl:flex" aria-label="Navegação principal">
      <a class="transition-colors hover:text-brand" href="/#casa">Para sua casa</a>
      <a class="transition-colors hover:text-brand" href="/#empresa">Para sua empresa</a>
      <a class="transition-colors hover:text-brand" href="/#condominios">Condomínios</a>
      <a class="transition-colors hover:text-brand" href="/#conteudos">Conteúdos</a>
      <a class="transition-colors hover:text-brand" href="/#sobre">Sobre</a>
    </nav>

    <div class="hidden items-center gap-3 xl:flex">
      <a class="btn min-h-11 border border-[var(--color-border-strong)] px-4 text-sm text-ink hover:border-brand/45" href="/#cobertura">
        Consultar cobertura
      </a>
      <a class="btn min-h-11 bg-brand px-4 text-sm text-white hover:bg-brand-strong" href={consultorUrl} target="_blank" rel="noreferrer">
        <Icon name="lucide:message-circle" class="size-4" />
        Falar com consultor
      </a>
    </div>

    <button
      type="button"
      class="grid size-11 place-items-center rounded-xl border border-[var(--color-border-strong)] text-brand xl:hidden"
      x-on:click="open = !open"
      x-bind:aria-expanded="open"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
    >
      <Icon name="lucide:menu" class="size-5" x-show="!open" />
      <Icon name="lucide:x" class="size-5" x-show="open" x-cloak />
    </button>
  </div>

  <div id="mobile-menu" class="border-t border-[var(--color-border)] bg-white xl:hidden" x-show="open" x-cloak>
    <nav class="container-shell grid gap-1 py-4 text-base" aria-label="Navegação mobile">
      <a class="rounded-xl px-3 py-3 hover:bg-soft" href="/#casa" x-on:click="open = false">Para sua casa</a>
      <a class="rounded-xl px-3 py-3 hover:bg-soft" href="/#empresa" x-on:click="open = false">Para sua empresa</a>
      <a class="rounded-xl px-3 py-3 hover:bg-soft" href="/#condominios" x-on:click="open = false">Condomínios</a>
      <a class="rounded-xl px-3 py-3 hover:bg-soft" href="/#conteudos" x-on:click="open = false">Conteúdos</a>
      <a class="rounded-xl px-3 py-3 hover:bg-soft" href="/#sobre" x-on:click="open = false">Sobre</a>
      <div class="mt-3 grid gap-3 border-t border-[var(--color-border)] pt-4 sm:grid-cols-2">
        <a class="btn border border-[var(--color-border-strong)] text-ink" href="/#cobertura" x-on:click="open = false">Consultar cobertura</a>
        <a class="btn bg-brand text-white" href={consultorUrl} target="_blank" rel="noreferrer">Falar com consultor</a>
      </div>
    </nav>
  </div>
</header>
