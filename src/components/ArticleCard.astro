---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { categorySlug, contentSlug, formatContentDate, readingTime } from '../lib/content';

interface Props {
  entry: CollectionEntry<'conteudos'>;
  featured?: boolean;
  filterExpression?: string;
}

const { entry, featured = false, filterExpression } = Astro.props;
const { title, summary, category, publishedAt, cover, coverAlt } = entry.data;
const href = `/conteudos/${contentSlug(entry)}/`;
---

<article class:list={['group', featured && 'md:col-span-2']} x-show={filterExpression}>
  <div class:list={['grid gap-6', featured && 'overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white p-2 md:grid-cols-[1.15fr_0.85fr] md:items-stretch md:gap-0']}>
    <a href={href} class:list={['block overflow-hidden rounded-2xl bg-soft', featured && 'md:rounded-r-none']} aria-label={`Ler ${title}`}>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 768, 1100]}
        sizes={featured ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 100vw, 42vw'}
        format="webp"
        quality={80}
        class:list={['w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]', featured ? 'aspect-[16/11] h-full' : 'aspect-[16/10]']}
      />
    </a>

    <div class:list={[featured ? 'flex flex-col justify-end p-5 sm:p-8 md:p-10' : 'pt-1']}>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        <a href={`/conteudos/categoria/${categorySlug(category)}/`} class="font-semibold text-brand hover:text-brand-strong">{category}</a>
        <span aria-hidden="true">|</span>
        <time datetime={publishedAt.toISOString()}>{formatContentDate(publishedAt)}</time>
        <span aria-hidden="true">|</span>
        <span>{readingTime(entry.body ?? '')}</span>
      </div>
      <h2 class:list={['mt-4 font-semibold leading-tight text-ink', featured ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
        <a href={href} class="transition-colors hover:text-brand">{title}</a>
      </h2>
      <p class:list={['mt-4 leading-7 text-muted', featured ? 'max-w-[48ch]' : 'max-w-[54ch]']}>{summary}</p>
      <a href={href} class="mt-7 inline-flex items-center gap-2 font-display text-sm font-semibold text-brand hover:text-brand-strong">
        Ler artigo
        <Icon name="lucide:arrow-up-right" class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</article>
